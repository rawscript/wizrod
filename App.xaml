<Application x:Class="Wizrod.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="Ink" Color="#F7FBFF" />
    <SolidColorBrush x:Key="MutedInk" Color="#BCD1DF" />
    <SolidColorBrush x:Key="Glass" Color="#B3263544" />
    <SolidColorBrush x:Key="GlassHover" Color="#8CFFFFFF" />
    <Style x:Key="RoundButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Glass}" />
      <Setter Property="BorderBrush" Value="#5CFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="15,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource GlassHover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value=".72" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
