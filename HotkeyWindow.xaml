<Window x:Class="Wizrod.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wizrod" Width="392" Height="290" MinWidth="320" MinHeight="250" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
  <Border x:Name="Shell" CornerRadius="27" BorderThickness="1.2" BorderBrush="#E8F3A5" Padding="16" ClipToBounds="True" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C64F5630" Offset="0"/><GradientStop Color="#DC313C1B" Offset=".52"/><GradientStop Color="#C7765A20" Offset="1"/></LinearGradientBrush></Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="14" Opacity=".52" Color="#17200D" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#20000000" BorderBrush="#EFFFF8B4" BorderThickness="1.2" CornerRadius="20" Padding="18,0">
        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="#FFFFF9A8" FontSize="16" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search clipboard" />
      </Border>
      <StackPanel Grid.Row="2" x:Name="MenuPanel">
        <Button x:Name="LibraryButton" Style="{StaticResource NavigationButton}" Height="59" HorizontalContentAlignment="Stretch" Click="Recents_Click">
          <Border x:Name="LibraryHighlight" Background="#365F6840" BorderBrush="#8CE4EFA0" BorderThickness="1" CornerRadius="18" Padding="20,0"><TextBlock Text="Library" Foreground="White" FontSize="21" VerticalAlignment="Center" /></Border>
        </Button>
        <Button x:Name="FavoritesButton" Style="{StaticResource NavigationButton}" Height="54" HorizontalContentAlignment="Stretch" Click="Favorites_Click">
          <TextBlock Text="Favourites" Foreground="#FFFFF9A8" FontSize="19" VerticalAlignment="Center" Margin="20,0" />
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Height="54" HorizontalContentAlignment="Stretch" Click="Settings_Click">
          <TextBlock Text="Settings" Foreground="#FFFFF9A8" FontSize="19" VerticalAlignment="Center" Margin="20,0" />
        </Button>
      </StackPanel>
      <Grid Grid.Row="3" x:Name="ContentPanel" Visibility="Collapsed" Margin="0,16,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,12"><Button Content="Back" Click="Back_Click" Style="{StaticResource NavigationButton}" DockPanel.Dock="Right"/><TextBlock x:Name="ItemCount" DockPanel.Dock="Right" Foreground="#DDE9A8" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="PanelTitle" Foreground="White" FontSize="18" VerticalAlignment="Center" /></DockPanel>
        <ListBox x:Name="ItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" SelectionChanged="ItemsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" ScrollViewer.PanningMode="Both">
          <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LibraryScrollBar}" /></ListBox.Resources>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><EventSetter Event="MouseRightButtonUp" Handler="Item_Favorite"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Border Background="#32FFFFFF" BorderBrush="#65FFF7A2" BorderThickness="1" CornerRadius="17" Padding="15,12" ToolTip="Click to paste. Use Favourite to save this item."><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="45" Foreground="White" FontSize="14"/><TextBlock Text="{Binding TimeLabel}" Foreground="#E0EDBF" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Favourite" Click="Favorite_Click" PreviewMouseLeftButtonDown="Favorite_PreviewMouseLeftButtonDown" VerticalAlignment="Center" Foreground="#FFFFF9A8" Background="#304B5427" BorderBrush="#A5FFF7A2" BorderThickness="1" Padding="9,5"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Background="#67404B24" BorderBrush="#B5FFF7A2" BorderThickness="1" CornerRadius="20" Padding="21"><StackPanel><TextBlock Text="Clipboard history lasts" Foreground="#FFFFF9A8" FontSize="14" Margin="0,0,0,8"/><ComboBox x:Name="RetentionPicker" Style="{StaticResource GlassComboBox}" SelectedIndex="2" SelectionChanged="RetentionPicker_SelectionChanged"><ComboBoxItem Content="1 day"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="14 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="Forever"/></ComboBox><CheckBox x:Name="FavoritesToggle" IsChecked="True" Content="Enable favourites" Foreground="#FFFFF9A8" Margin="0,18,0,0" Checked="FavoritesToggle_Changed" Unchecked="FavoritesToggle_Changed"/><StackPanel x:Name="FavoriteRetentionSection" Margin="0,14,0,0"><TextBlock Text="Favourites last" Foreground="#FFFFF9A8" FontSize="14" Margin="0,0,0,8"/><ComboBox x:Name="FavoriteRetentionPicker" Style="{StaticResource GlassComboBox}" SelectedIndex="3" SelectionChanged="FavoriteRetentionPicker_SelectionChanged"><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/><ComboBoxItem Content="1 year"/><ComboBoxItem Content="Forever"/></ComboBox></StackPanel></StackPanel></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
